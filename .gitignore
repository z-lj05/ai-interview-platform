.env
.env.*
!.env.example

# ── 运行期数据（上传的文件、日志、本地库）────────────────────
backend/uploads/
backend/logs/
*.log
*.db
*.sqlite3

# ── 编辑器 / 系统 ───────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

