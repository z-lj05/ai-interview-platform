# ── 依赖与虚拟环境（体积大头，不入库）──────────────────────────
.venv/
venv/
node_modules/
.tools/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── 前端构建产物 ────────────────────────────────────────────
dist/
build/

# ── 密钥与本地配置（★ 最重要的一条）────────────────────────
