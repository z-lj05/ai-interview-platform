# 复制成 .env 再填自己的值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交 —— 真实的 key 只写在这里

API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:<你的库口令>@localhost:5432/interview_db
# 生产环境请换成随机长串（JWT 签名用）
SECRET_KEY=dev-local-secret-key-please-change
API_V1_STR=/api/v1

# ── 大模型（必填，否则 AI 相关接口不可用）──────────────────────
# https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 阿里云 DashScope，用于 Embedding（text-embedding-v3，1024 维）
DASHSCOPE_API_KEY=

# ── 前端地址（邮件验证链接拼接用）──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── 邮件（开发环境走 MailHog 假 SMTP：1025 收信端口，8025 网页收件箱）──
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=user
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=AI-Interview
MAIL_ENCRYPTION=none
ADMIN_EMAIL=admin@example.com

# ── RAG 检索校准 ────────────────────────────────────────────
# 0.7 是常见默认值，但实测在本题库上召回为 0（命中相似度仅 0.44~0.53）；
# 按实际相似度分布校准到 0.45 后能召回到相关题、又挡得住无关题
QUESTION_BANK_MIN_SCORE=0.45
QUESTION_BANK_RECALL_FACTOR=2
QUESTION_BANK_TOP_K=20
